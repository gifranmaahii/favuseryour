# === Telegram ===
TELEGRAM_BOT_TOKEN=8746746683:AAFmV3k7yCRm6fVOFJvImM7cZIPPng_tcnk
# Telegram user ID admin (pisahkan koma jika lebih dari satu). Wajib diisi!
# Cek ID Anda dengan kirim /start ke bot, ID akan muncul di console.
TELEGRAM_ADMIN_IDS=

# === Pterodactyl Client API ===
PTERODACTYL_BASE_URL=https://public-server.verlang.id
PTERODACTYL_API_KEY=ptlc_XdmcllsLw4C3FXJSQ0ARpLhOhu9vjVU7HzeqD2e7TN6
PTERODACTYL_SERVER_ID=c0a6e650
# Timeout HTTP request ke panel (ms). Naikkan jika koneksi lambat.
PTERODACTYL_TIMEOUT_MS=60000
# Banyaknya retry otomatis untuk timeout / 5xx
PTERODACTYL_RETRIES=2

# === Path / data file di panel (relatif terhadap /home/container) ===
# File JSON tempat data bot anak (sewa) disimpan & dibaca via Files API
SEWA_FILE_PATH=/sewa.json
# Folder sesi WhatsApp (akan dihapus saat /logout)
SESSION_DIR=/session

# === Notifikasi otomatis ===
# Aktifkan listener console untuk auto-notify error/koneksi
ENABLE_CONSOLE_WATCHER=true
# Kata kunci yang memicu notifikasi (regex, pisahkan dengan |)
NOTIFY_PATTERNS=error|ECONNRESET|disconnect|connection closed|fatal|crash|reconnect

# === WhatsApp pair / connect detection ===
# Regex (group 1 = pairing code 8 char). Default sudah cukup umum.
WA_PAIR_REGEX=(?:pair(?:ing)?\s*code|kode\s*pairing)[^A-Z0-9]*([A-Z0-9]{4}[-\s]?[A-Z0-9]{4})
# Regex untuk mendeteksi bot anak SUKSES login. {number} otomatis diganti dgn nomor.
WA_CONNECTED_REGEX=(connected|logged\s*in|tersambung|online|ready|berhasil\s*login|open)
# Timeout (ms)
WA_PAIR_TIMEOUT_MS=60000
WA_CONNECT_TIMEOUT_MS=120000
